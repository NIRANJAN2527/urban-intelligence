# DRISHTIYANA - Supabase Backend Configuration
# Obtain these from: Supabase Project Settings -> API
# Note: Keep the service_role key SECRET. It must never be exposed to the browser.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# DRISHTIYANA - Secure Admin Portal Credentials
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=optional-random-hmac-secret-string
